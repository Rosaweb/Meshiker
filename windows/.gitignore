flutter/ephemeral/

# Régénérés à chaque `flutter pub get`/build (liste de plugins) : suivis
# dans le template Flutter par défaut, ce qui provoque un diff parasite
# à chaque build et bloque un `git checkout` si non commité entre-temps.
flutter/generated_plugin_registrant.cc
flutter/generated_plugin_registrant.h
flutter/generated_plugins.cmake

# Visual Studio user-specific files.
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio build-related files.
x64/
x86/

# Visual Studio cache files
# files ending in .cache can be ignored
*.[Cc]ache
# but keep track of directories ending in .cache
!*.[Cc]ache/
